DATABASE_URL=postgres://solv_user:solv_password@127.0.0.1:5432/solv_db?sslmode=disable
PORT=3000

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URL="https://solv.dedyn.io/auth/google/callback"

# Seguridad Interna
JWT_SECRET=your_jwt_secret_key_here

# Control de Admisión de Hardware (Calculado por cmd/autotune en Asus)
OOM_GUARD_MB=1408

# Almacenamiento de snapshots de avances (SeaweedFS, ADR-058)
SEAWEEDFS_ENDPOINT=http://127.0.0.1:8333
SEAWEEDFS_BUCKET=solv-advances
SEAWEEDFS_ACCESS_KEY=your_seaweedfs_access_key_here
SEAWEEDFS_SECRET_KEY=your_seaweedfs_secret_key_here
ADVANCE_SNAPSHOT_MAX_BYTES=4194304
ADVANCE_SNAPSHOT_MAX_FILES=512
ADVANCE_SNAPSHOT_EXCLUDES=.vscode/,.solv_*,.git/,node_modules/
# Aplicaciones de avance simultáneas; el resto espera en cola (ADR-058 §A13)
ADVANCE_APPLY_CONCURRENCY=4

# Configuración desec.io ACME TLS Wildcard
DESEC_TOKEN=your_desec_api_token_here
DESEC_DOMAIN=solv.dedyn.io
COOKIE_DOMAIN=.solv.dedyn.io
ACME_EMAIL=your_email_here@example.com