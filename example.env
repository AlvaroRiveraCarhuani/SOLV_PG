DATABASE_URL=postgres://solv_user:solv_password@127.0.0.1:5432/solv_db?sslmode=disable
PORT=3000

# Despliegue con imágenes (ver docs/DEPLOYMENT.md §8)
# Host público del sitio. Define rutas, certificado y el dominio de los entornos.
# No tiene valor por defecto: si falta, compose se detiene con un error en vez
# de publicar el sitio en un dominio ajeno.
SOLV_HOST=solv.midominio.edu
# Dominio con el que se publica cada entorno de práctica: el IDE queda en
# https://<uuid>.<BASE_DOMAIN>. Requiere el registro DNS comodín
# *.<BASE_DOMAIN> y el certificado comodín de DESEC_DOMAIN. Si queda vacío,
# el editor solo se alcanza desde el propio host en 127.0.0.1:<puerto>.
BASE_DOMAIN=solv.midominio.edu
# Tag de las imágenes solv-backend / solv-frontend. Cambiarlo es actualizar.
SOLV_VERSION=2.0.0
# Clave de PostgreSQL. En compose reemplaza al valor por defecto solv_password.
POSTGRES_PASSWORD=solv_password

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URL="https://solv.midominio.edu/auth/google/callback"

# Seguridad Interna
JWT_SECRET=your_jwt_secret_key_here
# Limitador global por IP (ADR-089). Perfil B: una persona con varias pestañas
# o hasta cuatro personas tras la misma dirección pública. Es el valor por
# defecto del binario.
RATE_LIMIT_IP_PER_MINUTE=600
RATE_LIMIT_IP_BURST=120
# Perfil C — aula compartida (hasta 30 alumnos con dos pestañas detrás de una
# única IP pública). Descomentar en el .env del laboratorio; no cambiar el
# valor por defecto del binario.
# RATE_LIMIT_IP_PER_MINUTE=3000
# RATE_LIMIT_IP_BURST=600

# Control de Admisión de Hardware (Calculado por cmd/autotune en Asus)
OOM_GUARD_MB=1408

# Almacenamiento de snapshots de avances (SeaweedFS, ADR-058)
SEAWEEDFS_ENDPOINT=http://127.0.0.1:8333
SEAWEEDFS_BUCKET=solv-advances
SEAWEEDFS_ACCESS_KEY=your_seaweedfs_access_key_here
SEAWEEDFS_SECRET_KEY=your_seaweedfs_secret_key_here
ADVANCE_SNAPSHOT_MAX_BYTES=4194304
ADVANCE_SNAPSHOT_MAX_FILES=512
ADVANCE_SNAPSHOT_EXCLUDES=.vscode/,.solv_*,.git/,node_modules/,.cache/,.openvscode-server/
# Aplicaciones de avance simultáneas; el resto espera en cola (ADR-058 §A13)
ADVANCE_APPLY_CONCURRENCY=4

# Proyecto inicial de las prácticas de Entorno de Desarrollo (ADR-068)
# Sin esta bandera el docente puede importar el proyecto y guardar el borrador,
# pero no publicar la versión: el alumno abre el entorno sin archivos.
WORKSPACE_PROJECTS_PUBLISH_ENABLED=true
# Proyectos grandes como tar.gz (ADR-090, hasta 32 MiB). Exige el depósito de
# objetos configurado arriba; apagada, el docente solo ve carpeta y ZIP.
WORKSPACE_PROJECT_ARCHIVE_ENABLED=true

# Preparación de dependencias por versión (ADR-069). Apagada por defecto: el
# worker instala go mod download / npm ci / pip install en un árbol por versión
# y el entorno del alumno lo enlaza al abrir. Sin ella cada alumno instala al
# empezar, dentro de su propio entorno.
DEPENDENCY_PREPARATION_ENABLED=true

# Extensión SOLV Companion montada en los entornos de práctica (ruta del host,
# no del contenedor: el bind lo crea el daemon de Docker). Requiere
# tools/solv-companion compilado (npm run compile). Vacío = sin extensión.
SOLV_COMPANION_HOST_PATH=

# Configuración desec.io ACME TLS Wildcard
DESEC_TOKEN=your_desec_api_token_here
DESEC_DOMAIN=midominio.edu
COOKIE_DOMAIN=.midominio.edu
ACME_EMAIL=your_email_here@example.com