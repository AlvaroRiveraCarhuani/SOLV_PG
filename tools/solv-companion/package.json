{
  "name": "solv-companion",
  "displayName": "SOLV Companion",
  "description": "Aula, avances del docente, comentarios y entrega dentro del laboratorio SOLV.",
  "version": "0.1.0",
  "publisher": "solv",
  "icon": "resources/icon.png",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "solv",
          "title": "SOLV",
          "icon": "resources/solv-activitybar.svg"
        }
      ]
    },
    "views": {
      "solv": [
        {
          "id": "solv.panel",
          "name": "Aula",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "solv.openTab",
        "title": "SOLV: Abrir consigna en pestaña",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "solv.refreshPanel",
        "title": "SOLV: Actualizar panel",
        "icon": "$(refresh)"
      },
      {
        "command": "solv.submit",
        "title": "SOLV: Entregar práctica",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "solv.broadcastAdvance",
        "title": "SOLV: Compartir avance con la clase",
        "icon": "$(broadcast)"
      },
      {
        "command": "solv.toggleFreeze",
        "title": "SOLV: Pausar o reanudar la clase",
        "icon": "$(debug-pause)"
      },
      {
        "command": "solv.showPresence",
        "title": "SOLV: Ver presencia del aula",
        "icon": "$(organization)"
      },
      {
        "command": "solv.openSpeedGrader",
        "title": "SOLV: Abrir evaluación en el navegador"
      },
      {
        "command": "solv.openAula",
        "title": "SOLV: Iniciar clase",
        "icon": "$(play)"
      },
      {
        "command": "solv.closeAula",
        "title": "SOLV: Cerrar clase",
        "icon": "$(debug-stop)"
      },
      {
        "command": "solv.configure",
        "title": "SOLV: Configurar conexión"
      },
      {
        "command": "solv.refreshComments",
        "title": "SOLV: Actualizar comentarios"
      },
      {
        "command": "solv.showTelemetryStatus",
        "title": "SOLV: Estado de la telemetría"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "solv.refreshPanel",
          "when": "view == solv.panel",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "solv.submit",
          "when": "solv:isStudent"
        },
        {
          "command": "solv.broadcastAdvance",
          "when": "solv:isTeacher"
        },
        {
          "command": "solv.toggleFreeze",
          "when": "solv:isTeacher"
        },
        {
          "command": "solv.showPresence",
          "when": "solv:isTeacher"
        },
        {
          "command": "solv.openSpeedGrader",
          "when": "solv:isTeacher"
        }
      ]
    },
    "configuration": {
      "title": "SOLV Companion",
      "properties": {
        "solv.apiBaseUrl": {
          "type": "string",
          "default": "",
          "description": "URL base de la API de SOLV, sin barra final."
        },
        "solv.submissionId": {
          "type": "string",
          "default": "",
          "description": "Identificador de la entrega que se está revisando."
        },
        "solv.role": {
          "type": "string",
          "enum": [
            "student",
            "teacher",
            "admin"
          ],
          "default": "student",
          "description": "Rol del editor. La variable de entorno SOLV_USER_ROLE tiene prioridad."
        },
        "solv.sessionId": {
          "type": "string",
          "default": "",
          "description": "Aula abierta del docente o aula de la práctica del alumno."
        },
        "solv.exerciseId": {
          "type": "string",
          "default": "",
          "description": "Ejercicio de la práctica en curso."
        },
        "solv.subjectId": {
          "type": "string",
          "default": "",
          "description": "Materia del laboratorio, para resolver el entorno al entregar."
        },
        "solv.workspaceId": {
          "type": "string",
          "default": "",
          "description": "Entorno del laboratorio cuando el dato viene inyectado."
        },
        "solv.subjectCode": {
          "type": "string",
          "default": "",
          "description": "Código de la materia que se muestra en el panel y en la barra de estado."
        },
        "solv.subjectTitle": {
          "type": "string",
          "default": "",
          "description": "Nombre de la materia que se muestra en el panel."
        },
        "solv.teacherName": {
          "type": "string",
          "default": "",
          "description": "Docente a cargo de la materia."
        },
        "solv.assignmentTitle": {
          "type": "string",
          "default": "",
          "description": "Título de la práctica en curso."
        },
        "solv.assignmentSummary": {
          "type": "string",
          "default": "",
          "description": "Resumen de la consigna que muestra el panel."
        },
        "solv.exercisePurpose": {
          "type": "string",
          "enum": [
            "class",
            "exam"
          ],
          "default": "class",
          "description": "Propósito pedagógico del ejercicio: clase formativa o examen calificado."
        },
        "solv.assignmentCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Criterios de evaluación que muestra el panel."
        },
        "solv.speedGraderUrl": {
          "type": "string",
          "default": "",
          "description": "URL de la evaluación para el acceso rápido del docente."
        },
        "solv.comments.refreshSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "Cada cuántos segundos se consultan los comentarios."
        },
        "solv.advances.refreshSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 15,
          "description": "Cada cuántos segundos se consultan los avances del aula."
        },
        "solv.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Registra inserciones y pegados masivos para la cadencia forense."
        },
        "solv.telemetry.pasteThreshold": {
          "type": "number",
          "default": 50,
          "minimum": 2,
          "description": "Cantidad de caracteres insertados de una vez que se considera pegado masivo."
        }
      }
    },
    "colors": [
      {
        "id": "solv.comment.background",
        "description": "Fondo de la línea comentada por el docente.",
        "defaults": {
          "light": "#FFF7E0",
          "dark": "#3A2E12",
          "highContrast": "#000000",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "solv.comment.border",
        "description": "Borde del margen de la línea comentada.",
        "defaults": {
          "light": "#D97706",
          "dark": "#FBBF24",
          "highContrast": "#FFFF00",
          "highContrastLight": "#000000"
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test \"out/**/*.test.js\"",
    "watch": "tsc -w -p .",
    "clean": "rm -rf out",
    "package": "npm run compile && vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@vscode-elements/elements": "^2.5.1"
  }
}
